# Compose project
COMPOSE_PROJECT_NAME=taskflow

# PostgreSQL initialization
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-long-local-password

# Backend runtime
APP_NAME=TaskFlow
APP_VERSION=dev
LOG_LEVEL=INFO
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY=3

# Redis runtime
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-local-redis-password
REDIS_DB=0
CACHE_TTL_SECONDS=60

# Browser-facing API path; used at frontend build time
VITE_API_BASE_URL=/api

# Empty is correct while Nginx serves frontend and proxies /api itself
CORS_ORIGINS=
